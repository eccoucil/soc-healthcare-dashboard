# Session encryption key (min 32 characters — generate with: openssl rand -hex 32)
SESSION_SECRET=<random-64-char-hex-string>

# ArcSight ESM DETECT REST API
ARCSIGHT_API_BASE_URL=https://<host>:58443/detect-api/rest
ARCSIGHT_LOGIN_URL=https://<host>:58443/www/core-service/rest/LoginService/login

# ArcSight Phoenix GWT-RPC (for Data Monitors / Active Channels)
ARCSIGHT_PHOENIX_URL=https://<host>:58443
ARCSIGHT_PHOENIX_LOGIN_STRONG_NAME=<login-service-strong-name>
ARCSIGHT_PHOENIX_DATAMONITOR_STRONG_NAME=<datamonitor-service-strong-name>
ARCSIGHT_DEFAULT_CHANNEL_GROUP_ID=<default-data-monitor-resource-id>

# GWT module permutation hash — same for ALL Phoenix services.
# The per-service strong names below go only in the request body.
ARCSIGHT_PHOENIX_PERMUTATION=CB3DBC2F5104708621DAEEEBF767F03B

# ChannelService (Active Channel events via GWT-RPC)
# Strong name (serialization policy hash) for ChannelService
ARCSIGHT_CHANNEL_STRONG_NAME=91BA6254AC077B3B739C11EF760F47FF
# Active channel resource/alias IDs (Base64-encoded ArcSight resource refs)
ARCSIGHT_CHANNEL_RESOURCE_ID=<active-channel-resource-id>
ARCSIGHT_CHANNEL_ALIAS_ID=<active-channel-alias-id>

# FieldSet resource ID for channel/event data (auto-discovered from path if blank)
ARCSIGHT_FIELD_SET_ID=
ARCSIGHT_FIELD_SET_PATH=/All Field Sets/FORTRESS/Device Monitoring

# GroupService (Active Channel group hierarchy via GWT-RPC)
ARCSIGHT_GROUP_STRONG_NAME=1B071B5D44F7515FFE5935DBF4E7ECC9

# ReportService (Report definitions + execution via GWT-RPC)
# Auto-discover via /api/arcsight/reports/discover if blank
ARCSIGHT_REPORT_STRONG_NAME=

# EventService (Full event details — all ~450 CEF fields via GWT-RPC)
ARCSIGHT_EVENT_STRONG_NAME=51097F59CEAD73CED97BA5CE4939E8FA

# ArcSight Manager Service Layer (event search via QueryService)
# Auto-discovery: tries same host as PHOENIX_URL on /www/manager-service/rest/ first,
# then falls back to port 8443. Override with explicit URL if needed.
ARCSIGHT_MANAGER_URL=

# Optional: Proxy for ArcSight connections (split tunneling)
# Routes only ArcSight traffic through the proxy; all other traffic flows normally.
# Supports: http://, https://, socks5://, socks5h:// (DNS resolved via proxy)
# Example: ARCSIGHT_PROXY_URL=socks5h://127.0.0.1:1080
ARCSIGHT_PROXY_URL=

# Device Inactivity Email Alerts (Resend)
# Sends email when a device channel goes silent for 5+ minutes.
# Get API key from https://resend.com — use onboarding@resend.dev as FROM for testing.
RESEND_API_KEY=
ALERT_EMAIL_FROM=ECC-SOC Alerts <onboarding@resend.dev>
ALERT_EMAIL_RECIPIENTS=cyberdefence.engineer@eccouncil.org,soc.analyst@eccouncil.org
ALERT_INACTIVITY_THRESHOLD_MS=300000
ALERT_POLL_INTERVAL_MS=300000

